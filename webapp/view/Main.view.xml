<mvc:View controllerName="zppsetupmatrix.controller.Main"   
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:upload="sap.m.upload"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}">
        <content>
            <upload:UploadSet
                id="excelUploadSet"
                instantUpload="true"
                maxFileNameLength="50"
                afterItemAdded="onFileAdded"
                uploadCompleted="onUploadComplete"
                mode="None"
                 >
                <upload:toolbar>
                    <OverflowToolbar id="_IDGenOverflowToolbar">
                        <ToolbarSpacer id="_IDGenToolbarSpacer1"/>
                        <Button id="uploadBtn" text="Generate Setup Matrices" press="onUploadTrigger" type="Emphasized" enabled="false"/>
                    </OverflowToolbar>
                </upload:toolbar>
            </upload:UploadSet>
        </content>
    </Page>
</mvc:View>